{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verdaccio Cache Manager",
  "version": "0.1.24",
  "identifier": "com.verdaccio-cache-manager",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verdaccio Cache Manager",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0ZGRTMyMDdBQTk4QjAKUldTd21Lb0hNdjQvZHU1RDd4SHdDQmx5bnhVVXJ2VzNaZ29XTjFBc0toNEY0YkJEc3V0Tm52YWUK",
      "endpoints": [
        "https://github.com/Eyeseas/verdaccio-cache-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
